{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "Proxy": {
    "ListenPort": 3000,
    "RoutePrefix": "claude-kiro-oauth",
    "Backend": "KiroApi",
    "Upstream": {
      "BaseUrl": "https://api.anthropic.com",
      "ApiKey": "",
      "TimeoutSeconds": 180,
      "MaxRetries": 3
    },
    "KiroApi": {
      "NodeCommand": "node",
      "Region": "us-east-1",
      "Endpoint": "https://q.us-east-1.amazonaws.com",
      "TokenFilePath": "/app/tokens/kiro-auth-token.json",
      "RegistrationCacheDirectory": "/app/tokens",
      "ContentCollectionEnabled": false,
      "AgentMode": "vibe"
    },
    "Models": {
      "Default": "claude-sonnet-4",
      "Available": [
        "claude-sonnet-4",
        "claude-opus-4.1",
        "kiro-default"
      ]
    },
    "Cache": {
      "Enabled": true,
      "Directory": "llm-cache",
      "TtlMinutes": 1440,
      "MaxSizeMB": 500
    }
  },
  "AllowedHosts": "*"
}
